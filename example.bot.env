# Agent-affiliation backend
API_BASE_URL=https://tlcw.sxjzsz.com/prod-api
API_USERNAME=change-me
API_PASSWORD=change-me

# Ban administration backend
# The current real backend uses HTTP. Use it only on a trusted network or VPN.
BAN_ADMIN_LOGIN_URL=http://tl16.hgwmsc.cn:81/#/login
BAN_ADMIN_USERNAME=change-me
BAN_ADMIN_PASSWORD=change-me
BAN_ADMIN_OCR_URL=http://127.0.0.1:8000/ocr6

# Telegram
TELEGRAM_BOT_TOKEN=change-me
# For group button workflows, disable Group Privacy with BotFather /setprivacy.
# The super-admin can add and remove ordinary admins from the private-chat menu.
TELEGRAM_SUPER_ADMIN_ID=123456789
# Optional immutable admins managed in .env. Runtime admins use the JSON store.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ADMIN_STORE_PATH=.telegram-admins.json
# Plaintext password replies are deleted after this many seconds; 0 disables deletion.
TELEGRAM_SECRET_MESSAGE_TTL_SECONDS=60
